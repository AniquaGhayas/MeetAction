# ==============================================================================
# MeetAction Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?schema=public
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=meetaction

# Job Queue Cache & Broker (Redis)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
# 32-byte hexadecimal key for AES-256 token encryption at rest
TOKEN_ENCRYPTION_KEY=replace_with_a_32_byte_hex_encryption_key

# LLM Extraction Provider (OpenAI or Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Speech-to-Text Provider (Whisper, Deepgram, or AssemblyAI)
STT_PROVIDER=whisper
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Jira OAuth 2.0 (3LO) Integration
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_CALLBACK_URL=http://localhost:5000/api/integrations/jira/callback

# Trello Integration
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_CALLBACK_URL=http://localhost:5000/api/integrations/trello/callback

# Object Storage (AWS S3 / Cloudflare R2 / MinIO for audio and transcript storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=meetaction-uploads

